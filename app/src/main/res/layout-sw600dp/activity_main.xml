<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/app_background"
	android:padding="48dp">

	<TextView
		android:id="@+id/devModeEntry"
		android:layout_width="88dp"
		android:layout_height="52dp"
		android:background="@drawable/menu_tile_background"
		android:clickable="true"
		android:contentDescription="Dev-Modus öffnen"
		android:focusable="true"
		android:foreground="?attr/selectableItemBackground"
		android:gravity="center"
		android:text="DEV"
		android:textSize="18sp"
		android:textStyle="bold"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<LinearLayout
		android:id="@+id/welcomeContainer"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:orientation="vertical"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent">

		<ImageView
			android:id="@+id/logoImage"
			android:layout_width="180dp"
			android:layout_height="180dp"
			android:contentDescription="@string/app_name"
			android:src="@mipmap/ic_launcher" />

		<TextView
			android:id="@+id/welcomeText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:text="@string/welcome"
			android:textAppearance="@style/TextAppearance.MaterialComponents.Headline4" />
	</LinearLayout>

	<GridLayout
		android:id="@+id/menuContainer"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:alignmentMode="alignBounds"
		android:alpha="0"
		android:columnCount="4"
		android:rowCount="2"
		android:visibility="gone"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent">

		<!-- Zeile 0 -->
		<TextView
			android:id="@+id/salesTile"
			android:layout_width="110dp"
			android:layout_height="110dp"
			android:layout_margin="8dp"
			android:layout_row="0"
			android:layout_column="0"
			android:layout_gravity="fill"
			android:autoSizeMaxTextSize="22sp"
			android:autoSizeMinTextSize="12sp"
			android:autoSizeStepGranularity="1sp"
			android:autoSizeTextType="uniform"
			android:background="@drawable/menu_tile_background"
			android:clickable="true"
			android:focusable="true"
			android:foreground="?attr/selectableItemBackground"
			android:gravity="center"
			android:includeFontPadding="false"
			android:maxLines="2"
			android:padding="10dp"
			android:text="@string/tile_sales" />

		<TextView
			android:id="@+id/ordersTile"
			android:layout_width="110dp"
			android:layout_height="110dp"
			android:layout_margin="8dp"
			android:layout_row="0"
			android:layout_column="1"
			android:layout_gravity="fill"
			android:autoSizeMaxTextSize="22sp"
			android:autoSizeMinTextSize="12sp"
			android:autoSizeStepGranularity="1sp"
			android:autoSizeTextType="uniform"
			android:background="@drawable/menu_tile_background"
			android:clickable="true"
			android:focusable="true"
			android:foreground="?attr/selectableItemBackground"
			android:gravity="center"
			android:includeFontPadding="false"
			android:maxLines="2"
			android:padding="10dp"
			android:text="Bestellungen" />

		<TextView
			android:id="@+id/dailyReportTile"
			android:layout_width="110dp"
			android:layout_height="110dp"
			android:layout_margin="8dp"
			android:layout_row="0"
			android:layout_column="2"
			android:layout_gravity="fill"
			android:autoSizeMaxTextSize="22sp"
			android:autoSizeMinTextSize="12sp"
			android:autoSizeStepGranularity="1sp"
			android:autoSizeTextType="uniform"
			android:background="@drawable/menu_tile_background"
			android:clickable="true"
			android:focusable="true"
			android:foreground="?attr/selectableItemBackground"
			android:gravity="center"
			android:includeFontPadding="false"
			android:maxLines="2"
			android:padding="10dp"
			android:text="Tages-\nabschluss" />

		<TextView
			android:id="@+id/settingsTile"
			android:layout_width="110dp"
			android:layout_height="110dp"
			android:layout_margin="8dp"
			android:layout_row="0"
			android:layout_column="3"
			android:layout_gravity="fill"
			android:autoSizeMaxTextSize="22sp"
			android:autoSizeMinTextSize="12sp"
			android:autoSizeStepGranularity="1sp"
			android:autoSizeTextType="uniform"
			android:background="@drawable/menu_tile_background"
			android:clickable="true"
			android:focusable="true"
			android:foreground="?attr/selectableItemBackground"
			android:gravity="center"
			android:includeFontPadding="false"
			android:maxLines="2"
			android:padding="10dp"
			android:text="@string/tile_settings" />

		<!-- Zeile 1 -->
		<TextView
			android:id="@+id/articleManagementTile"
			android:layout_width="110dp"
			android:layout_height="110dp"
			android:layout_margin="8dp"
			android:layout_row="1"
			android:layout_column="0"
			android:layout_gravity="fill"
			android:autoSizeMaxTextSize="22sp"
			android:autoSizeMinTextSize="12sp"
			android:autoSizeStepGranularity="1sp"
			android:autoSizeTextType="uniform"
			android:background="@drawable/menu_tile_background"
			android:clickable="true"
			android:focusable="true"
			android:foreground="?attr/selectableItemBackground"
			android:gravity="center"
			android:includeFontPadding="false"
			android:maxLines="2"
			android:padding="10dp"
			android:text="@string/tile_item_maintenance" />

		<TextView
			android:id="@+id/depositReturnTile"
			android:layout_width="110dp"
			android:layout_height="110dp"
			android:layout_margin="8dp"
			android:layout_row="1"
			android:layout_column="1"
			android:layout_gravity="fill"
			android:autoSizeMaxTextSize="22sp"
			android:autoSizeMinTextSize="12sp"
			android:autoSizeStepGranularity="1sp"
			android:autoSizeTextType="uniform"
			android:background="@drawable/menu_tile_background"
			android:clickable="true"
			android:focusable="true"
			android:foreground="?attr/selectableItemBackground"
			android:gravity="center"
			android:includeFontPadding="false"
			android:maxLines="2"
			android:padding="10dp"
			android:text="@string/tile_deposit_return" />

		<TextView
			android:id="@+id/archiveTile"
			android:layout_width="110dp"
			android:layout_height="110dp"
			android:layout_margin="8dp"
			android:layout_row="1"
			android:layout_column="2"
			android:layout_gravity="fill"
			android:autoSizeMaxTextSize="22sp"
			android:autoSizeMinTextSize="12sp"
			android:autoSizeStepGranularity="1sp"
			android:autoSizeTextType="uniform"
			android:background="@drawable/menu_tile_background"
			android:gravity="center"
			android:includeFontPadding="false"
			android:maxLines="2"
			android:padding="10dp"
			android:text="@string/tile_archive" />

		<TextView
			android:id="@+id/updateTile"
			android:layout_width="110dp"
			android:layout_height="110dp"
			android:layout_margin="8dp"
			android:layout_row="1"
			android:layout_column="3"
			android:layout_gravity="fill"
			android:autoSizeMaxTextSize="22sp"
			android:autoSizeMinTextSize="12sp"
			android:autoSizeStepGranularity="1sp"
			android:autoSizeTextType="uniform"
			android:background="@drawable/menu_tile_background"
			android:clickable="true"
			android:focusable="true"
			android:foreground="?attr/selectableItemBackground"
			android:gravity="center"
			android:includeFontPadding="false"
			android:maxLines="2"
			android:padding="10dp"
			android:text="@string/update_tile_symbol" />

	</GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
