<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginBottom="8dp"
	android:background="#EEFFFFFF"
	android:orientation="vertical"
	android:padding="10dp">

	<TextView
		android:id="@+id/discoveredDeviceName"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:textColor="#111111"
		android:textStyle="bold"
		android:textSize="18sp"
		android:text="Gerätename" />

	<TextView
		android:id="@+id/discoveredDeviceInfo"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="2dp"
		android:textColor="#222222"
		android:textSize="14sp"
		android:text="192.168.1.10:18550" />

	<TextView
		android:id="@+id/discoveredDeviceStatus"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="2dp"
		android:textColor="#1B5E20"
		android:textSize="14sp"
		android:text="Gekoppelt" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:orientation="horizontal">

		<Button
			android:id="@+id/discoveredDeviceConnectButton"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:backgroundTint="#2E7D32"
			android:text="Verbinden"
			android:textColor="#FFFFFF" />

		<Button
			android:id="@+id/discoveredDeviceRemoveButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="8dp"
			android:backgroundTint="#B71C1C"
			android:text="Entfernen"
			android:textColor="#FFFFFF" />
	</LinearLayout>

</LinearLayout>
