<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/app_background"
	android:padding="16dp">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical">

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Geräte synchronisieren"
			android:textColor="#FFFFFF"
			android:textStyle="bold"
			android:textSize="26sp" />

		<TextView
			android:id="@+id/syncDeviceInfoText"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:textColor="#FFFFFF"
			android:textSize="15sp" />

		<TextView
			android:id="@+id/syncStatusText"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:textColor="#FFFFFF"
			android:textStyle="bold"
			android:textSize="18sp"
			android:text="Offline" />

		<EditText
			android:id="@+id/syncHostInput"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:hint="Host-IP (z. B. 192.168.178.10)"
			android:inputType="text" />

		<EditText
			android:id="@+id/syncPortInput"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:hint="Port (z. B. 18550)"
			android:inputType="number"
			android:text="18550" />

		<EditText
			android:id="@+id/syncCodeInput"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:hint="Gerätecode"
			android:inputType="textPassword"
			android:text="123456" />

		<Button
			android:id="@+id/syncStartHostButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:layout_marginTop="12dp"
			android:text="Host starten"
			android:backgroundTint="#1565C0"
			android:textColor="#FFFFFF" />

		<Button
			android:id="@+id/syncConnectButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:layout_marginTop="8dp"
			android:text="Mit Gerät verbinden"
			android:backgroundTint="#2E7D32"
			android:textColor="#FFFFFF" />

		<Button
			android:id="@+id/syncNowButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:layout_marginTop="8dp"
			android:text="Jetzt synchronisieren"
			android:backgroundTint="#6A1B9A"
			android:textColor="#FFFFFF" />

		<Button
			android:id="@+id/syncDisconnectButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:layout_marginTop="8dp"
			android:text="Verbindung trennen"
			android:backgroundTint="#B71C1C"
			android:textColor="#FFFFFF" />

		<Button
			android:id="@+id/syncCloseButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:layout_marginTop="8dp"
			android:text="Schließen"
			android:backgroundTint="#455A64"
			android:textColor="#FFFFFF" />

	</LinearLayout>
</ScrollView>
