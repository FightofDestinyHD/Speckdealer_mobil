<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/app_background"
	android:orientation="vertical"
	android:padding="16dp">

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingBottom="12dp"
		android:text="Tagesabschluss"
		android:textColor="#FFFFFF"
		android:textSize="28sp"
		android:textStyle="bold" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:orientation="horizontal"
		android:baselineAligned="false">

		<ScrollView
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="2"
			android:layout_marginEnd="10dp"
			android:fillViewport="true">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="#CCFFFFFF"
					android:padding="12dp"
					android:text="Umsatzübersicht"
					android:textSize="20sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/reportSummaryText"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="10dp"
					android:background="#CCFFFFFF"
					android:padding="12dp"
					android:textSize="17sp" />

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="#CCFFFFFF"
					android:padding="12dp"
					android:text="Getränke – MwSt. 19 %"
					android:textSize="20sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/reportBeverageVatText"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="10dp"
					android:background="#CCFFFFFF"
					android:padding="12dp"
					android:textSize="17sp" />

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="#CCFFFFFF"
					android:padding="12dp"
					android:text="Speisen – MwSt. 7 %"
					android:textSize="20sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/reportFoodVatText"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="10dp"
					android:background="#CCFFFFFF"
					android:padding="12dp"
					android:textSize="17sp" />

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="#CCFFFFFF"
					android:padding="12dp"
					android:text="Verkaufsdetails"
					android:textSize="20sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/reportSalesDetailsText"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="10dp"
					android:background="#CCFFFFFF"
					android:padding="12dp"
					android:textSize="17sp" />

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="#CCFFFFFF"
					android:padding="12dp"
					android:text="Mitarbeiterverkäufe"
					android:textSize="20sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/reportEmployeeText"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="#CCFFFFFF"
					android:padding="12dp"
					android:textSize="17sp" />
			</LinearLayout>
		</ScrollView>

		<ScrollView
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:fillViewport="true">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="#CCFFFFFF"
					android:padding="12dp"
					android:text="Pfand"
					android:textSize="20sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/reportDepositSummaryText"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="10dp"
					android:background="#CCFFFFFF"
					android:padding="12dp"
					android:textSize="17sp" />

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="#CCFFFFFF"
					android:padding="12dp"
					android:text="Pfand nach Art"
					android:textSize="20sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/reportDepositBreakdownText"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="#CCFFFFFF"
					android:padding="12dp"
					android:textSize="17sp" />
			</LinearLayout>
		</ScrollView>
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:paddingTop="12dp">

		<Button
			android:id="@+id/reportResetButton"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginEnd="8dp"
			android:backgroundTint="#B71C1C"
			android:text="Tag abschließen &amp; zurücksetzen"
			android:textColor="#FFFFFF" />

		<Button
			android:id="@+id/reportCloseButton"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:backgroundTint="#1B5E20"
			android:text="Schließen"
			android:textColor="#FFFFFF" />
	</LinearLayout>
</LinearLayout>
