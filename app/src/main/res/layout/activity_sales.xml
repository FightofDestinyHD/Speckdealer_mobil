<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/app_background"
	android:orientation="vertical"
	android:padding="12dp">

	<HorizontalScrollView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:fillViewport="true"
		android:scrollbars="none">

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:padding="8dp"
			android:background="#CCFFFFFF">

			<Button
				android:id="@+id/categoryWeinButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Wein" />

			<Button
				android:id="@+id/categorySoftButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="6dp"
				android:text="Softgetränke" />

			<Button
				android:id="@+id/categorySpeckButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="6dp"
				android:text="Speck" />

			<Button
				android:id="@+id/categoryKaeseButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="6dp"
				android:text="Käse" />

			<Button
				android:id="@+id/categorySnacksButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="6dp"
				android:text="Snacks" />

			<Button
				android:id="@+id/categoryAngebotButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="6dp"
				android:text="Angebot" />

			<Button
				android:id="@+id/depositReturnActionButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="6dp"
				android:text="Pfandrückgabe" />

		</LinearLayout>
	</HorizontalScrollView>

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/salesArticleRecyclerView"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_marginTop="10dp"
		android:layout_weight="1"
		android:background="#CCFFFFFF"
		android:clipToPadding="false"
		android:padding="8dp" />

	<LinearLayout
		android:id="@+id/cartContainer"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_marginTop="8dp"
		android:layout_weight="1"
		android:background="#E8FFFFFF"
		android:orientation="vertical"
		android:padding="8dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="🛒 Warenkorb"
				android:textSize="16sp"
				android:textStyle="bold" />

			<Button
				android:id="@+id/cartClearButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:backgroundTint="#B71C1C"
				android:text="Leeren"
				android:textColor="#FFFFFF"
				android:textSize="12sp" />

		</LinearLayout>

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:layout_marginTop="6dp"
			android:layout_marginBottom="6dp"
			android:background="#AAAAAA" />

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/cartRecyclerView"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1" />

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:layout_marginTop="6dp"
			android:layout_marginBottom="4dp"
			android:background="#AAAAAA" />

		<TextView
			android:id="@+id/cartTotalText"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Gesamt: 0,00 €"
			android:textSize="16sp"
			android:textStyle="bold" />

		<Button
			android:id="@+id/cartCheckoutButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:layout_marginTop="8dp"
			android:backgroundTint="#1B5E20"
			android:text="Kassieren"
			android:textColor="#FFFFFF" />

	</LinearLayout>

</LinearLayout>
