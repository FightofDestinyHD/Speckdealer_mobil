<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/app_background"
	android:padding="24dp">

	<TextView
		android:id="@+id/devModeEntry"
		android:layout_width="64dp"
		android:layout_height="40dp"
		android:background="@drawable/menu_tile_background"
		android:clickable="true"
		android:contentDescription="Dev-Modus öffnen"
		android:focusable="true"
		android:foreground="?attr/selectableItemBackground"
		android:gravity="center"
		android:text="DEV"
		android:textStyle="bold"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<LinearLayout
		android:id="@+id/welcomeContainer"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:orientation="vertical"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent">

		<ImageView
			android:id="@+id/logoImage"
			android:layout_width="120dp"
			android:layout_height="120dp"
			android:contentDescription="@string/app_name"
			android:src="@mipmap/ic_launcher" />

		<TextView
			android:id="@+id/welcomeText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:text="@string/welcome"
			android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5" />
	</LinearLayout>

	<androidx.core.widget.NestedScrollView
		android:id="@+id/menuScrollContainer"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:fillViewport="true"
		android:clipToPadding="false"
		android:visibility="gone"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent">

		<GridLayout
			android:id="@+id/menuContainer"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:alignmentMode="alignBounds"
			android:alpha="0"
			android:columnCount="4"
			android:rowCount="3"
			android:useDefaultMargins="false"
			android:visibility="gone"
			android:paddingStart="6dp"
			android:paddingEnd="6dp"
			android:paddingTop="6dp"
			android:paddingBottom="10dp">

			<TextView
				android:id="@+id/salesTile"
				android:layout_width="0dp"
				android:layout_height="78dp"
				android:layout_margin="4dp"
				android:layout_column="0"
				android:layout_columnWeight="1"
				android:layout_gravity="fill_horizontal"
				android:background="@drawable/menu_tile_background"
				android:clickable="true"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground"
				android:gravity="center"
				android:includeFontPadding="false"
				android:ellipsize="none"
				android:maxLines="2"
				android:padding="6dp"
				android:text="@string/tile_sales_tablet"
				android:textAlignment="center"
				android:textSize="14sp" />

			<TextView
				android:id="@+id/ordersTile"
				android:layout_width="0dp"
				android:layout_height="78dp"
				android:layout_margin="4dp"
				android:layout_column="1"
				android:layout_columnWeight="1"
				android:layout_gravity="fill_horizontal"
				android:background="@drawable/menu_tile_background"
				android:clickable="true"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground"
				android:gravity="center"
				android:includeFontPadding="false"
				android:ellipsize="none"
				android:maxLines="2"
				android:padding="6dp"
				android:text="@string/tile_orders_phone"
				android:textAlignment="center"
				android:textSize="14sp" />

			<TextView
				android:id="@+id/dailyReportTile"
				android:layout_width="0dp"
				android:layout_height="78dp"
				android:layout_margin="4dp"
				android:layout_column="2"
				android:layout_columnWeight="1"
				android:layout_gravity="fill_horizontal"
				android:background="@drawable/menu_tile_background"
				android:clickable="true"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground"
				android:gravity="center"
				android:includeFontPadding="false"
				android:ellipsize="none"
				android:maxLines="2"
				android:padding="6dp"
				android:text="@string/tile_daily_report_phone"
				android:textAlignment="center"
				android:textSize="14sp" />

			<TextView
				android:id="@+id/settingsTile"
				android:layout_width="0dp"
				android:layout_height="78dp"
				android:layout_margin="4dp"
				android:layout_column="3"
				android:layout_columnWeight="1"
				android:layout_gravity="fill_horizontal"
				android:background="@drawable/menu_tile_background"
				android:clickable="true"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground"
				android:gravity="center"
				android:includeFontPadding="false"
				android:ellipsize="none"
				android:maxLines="2"
				android:padding="6dp"
				android:text="@string/tile_settings_tablet"
				android:textAlignment="center"
				android:textSize="14sp" />

			<TextView
				android:id="@+id/articleManagementTile"
				android:layout_width="0dp"
				android:layout_height="78dp"
				android:layout_margin="4dp"
				android:layout_column="0"
				android:layout_columnWeight="1"
				android:layout_gravity="fill_horizontal"
				android:background="@drawable/menu_tile_background"
				android:clickable="true"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground"
				android:gravity="center"
				android:includeFontPadding="false"
				android:ellipsize="none"
				android:maxLines="2"
				android:padding="6dp"
				android:text="@string/tile_item_maintenance_phone"
				android:textAlignment="center"
				android:textSize="14sp" />

			<TextView
				android:id="@+id/depositReturnTile"
				android:layout_width="0dp"
				android:layout_height="78dp"
				android:layout_margin="4dp"
				android:layout_column="1"
				android:layout_columnWeight="1"
				android:layout_gravity="fill_horizontal"
				android:background="@drawable/menu_tile_background"
				android:clickable="true"
				android:ellipsize="none"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground"
				android:gravity="center"
				android:includeFontPadding="false"
				android:lines="2"
				android:maxLines="2"
				android:padding="6dp"
				android:text="@string/tile_deposit_return_phone"
				android:textAlignment="center"
				android:textSize="14sp" />

			<TextView
				android:id="@+id/archiveTile"
				android:layout_width="0dp"
				android:layout_height="78dp"
				android:layout_margin="4dp"
				android:layout_column="2"
				android:layout_columnWeight="1"
				android:layout_gravity="fill_horizontal"
				android:background="@drawable/menu_tile_background"
				android:clickable="true"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground"
				android:gravity="center"
				android:includeFontPadding="false"
				android:ellipsize="none"
				android:maxLines="2"
				android:padding="6dp"
				android:text="@string/tile_archive_tablet"
				android:textAlignment="center"
				android:textSize="14sp" />

			<TextView
				android:id="@+id/updateTile"
				android:layout_width="0dp"
				android:layout_height="78dp"
				android:layout_margin="4dp"
				android:layout_column="3"
				android:layout_columnWeight="1"
				android:layout_gravity="fill_horizontal"
				android:background="@drawable/menu_tile_background"
				android:clickable="true"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground"
				android:gravity="center"
				android:includeFontPadding="false"
				android:ellipsize="none"
				android:maxLines="2"
				android:padding="6dp"
				android:text="@string/tile_update_tablet"
				android:textAlignment="center"
				android:textSize="14sp" />

			<TextView
				android:id="@+id/deviceSyncTile"
				android:layout_width="0dp"
				android:layout_height="78dp"
				android:layout_margin="4dp"
				android:layout_column="0"
				android:layout_columnWeight="1"
				android:layout_gravity="fill_horizontal"
				android:background="@drawable/menu_tile_background"
				android:clickable="true"
				android:focusable="true"
				android:foreground="?attr/selectableItemBackground"
				android:gravity="center"
				android:includeFontPadding="false"
				android:ellipsize="none"
				android:maxLines="2"
				android:padding="6dp"
				android:text="@string/tile_device_sync_phone"
				android:textAlignment="center"
				android:textSize="14sp" />
		</GridLayout>
	</androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
