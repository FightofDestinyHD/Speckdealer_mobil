<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:padding="24dp">

	<LinearLayout
		android:id="@+id/welcomeContainer"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:orientation="vertical"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent">

		<ImageView
			android:id="@+id/logoImage"
			android:layout_width="120dp"
			android:layout_height="120dp"
			android:contentDescription="@string/app_name"
			android:src="@mipmap/ic_launcher" />

		<TextView
			android:id="@+id/welcomeText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:text="@string/welcome"
			android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5" />
	</LinearLayout>

	<GridLayout
		android:id="@+id/menuContainer"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:alignmentMode="alignMargins"
		android:alpha="0"
		android:columnCount="4"
		android:rowCount="2"
		android:useDefaultMargins="true"
		android:visibility="gone"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent">

		<TextView
			android:layout_width="72dp"
			android:layout_height="72dp"
			android:background="@drawable/menu_tile_background"
			android:gravity="center"
			android:text="@string/tile_sales" />

		<TextView
			android:layout_width="72dp"
			android:layout_height="72dp"
			android:background="@drawable/menu_tile_background"
			android:gravity="center"
			android:text="2" />

		<TextView
			android:layout_width="72dp"
			android:layout_height="72dp"
			android:background="@drawable/menu_tile_background"
			android:gravity="center"
			android:text="3" />

		<TextView
			android:layout_width="72dp"
			android:layout_height="72dp"
			android:background="@drawable/menu_tile_background"
			android:gravity="center"
			android:text="4" />

		<TextView
			android:layout_width="72dp"
			android:layout_height="72dp"
			android:background="@drawable/menu_tile_background"
			android:gravity="center"
			android:text="@string/tile_item_maintenance" />

		<TextView
			android:layout_width="72dp"
			android:layout_height="72dp"
			android:background="@drawable/menu_tile_background"
			android:gravity="center"
			android:text="6" />

		<TextView
			android:layout_width="72dp"
			android:layout_height="72dp"
			android:background="@drawable/menu_tile_background"
			android:gravity="center"
			android:text="@string/tile_archive" />

		<FrameLayout
			android:id="@+id/updateTile"
			android:layout_width="72dp"
			android:layout_height="72dp"
			android:background="@drawable/menu_tile_background"
			android:clickable="true"
			android:focusable="true"
			android:foreground="?attr/selectableItemBackground">

			<ImageView
				android:layout_width="44dp"
				android:layout_height="44dp"
				android:layout_gravity="center"
				android:src="@android:drawable/ic_popup_sync"
				android:tint="#FF606060" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center"
				android:text="@string/update_tile"
				android:textColor="#FF303030"
				android:textSize="10sp"
				android:textStyle="bold" />
		</FrameLayout>
	</GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
