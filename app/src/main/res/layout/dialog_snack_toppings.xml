<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="16dp">

	<!-- Gurken -->
	<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
		android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
		<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
			android:text="Gurken" android:textSize="15sp" />
		<Button android:id="@+id/gurkenMinus" android:layout_width="40dp" android:layout_height="40dp"
			android:text="−" android:textSize="18sp" android:padding="0dp" />
		<TextView android:id="@+id/gurkenCount" android:layout_width="36dp" android:layout_height="wrap_content"
			android:text="1" android:gravity="center" android:textSize="16sp" android:textStyle="bold" />
		<Button android:id="@+id/gurkenPlus" android:layout_width="40dp" android:layout_height="40dp"
			android:text="+" android:textSize="18sp" android:padding="0dp" />
	</LinearLayout>

	<!-- Tomaten -->
	<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
		android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
		<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
			android:text="Tomaten" android:textSize="15sp" />
		<Button android:id="@+id/tomatenMinus" android:layout_width="40dp" android:layout_height="40dp"
			android:text="−" android:textSize="18sp" android:padding="0dp" />
		<TextView android:id="@+id/tomatenCount" android:layout_width="36dp" android:layout_height="wrap_content"
			android:text="1" android:gravity="center" android:textSize="16sp" android:textStyle="bold" />
		<Button android:id="@+id/tomatenPlus" android:layout_width="40dp" android:layout_height="40dp"
			android:text="+" android:textSize="18sp" android:padding="0dp" />
	</LinearLayout>

	<!-- Zwiebeln -->
	<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
		android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
		<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
			android:text="Zwiebeln" android:textSize="15sp" />
		<Button android:id="@+id/zwiebelMinus" android:layout_width="40dp" android:layout_height="40dp"
			android:text="−" android:textSize="18sp" android:padding="0dp" />
		<TextView android:id="@+id/zwiebelCount" android:layout_width="36dp" android:layout_height="wrap_content"
			android:text="1" android:gravity="center" android:textSize="16sp" android:textStyle="bold" />
		<Button android:id="@+id/zwiebelPlus" android:layout_width="40dp" android:layout_height="40dp"
			android:text="+" android:textSize="18sp" android:padding="0dp" />
	</LinearLayout>

	<!-- Oliven -->
	<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
		android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
		<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
			android:text="Oliven" android:textSize="15sp" />
		<Button android:id="@+id/olivenMinus" android:layout_width="40dp" android:layout_height="40dp"
			android:text="−" android:textSize="18sp" android:padding="0dp" />
		<TextView android:id="@+id/olivenCount" android:layout_width="36dp" android:layout_height="wrap_content"
			android:text="1" android:gravity="center" android:textSize="16sp" android:textStyle="bold" />
		<Button android:id="@+id/olivenPlus" android:layout_width="40dp" android:layout_height="40dp"
			android:text="+" android:textSize="18sp" android:padding="0dp" />
	</LinearLayout>

	<!-- Brezeln -->
	<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
		android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
		<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
			android:text="Brezeln" android:textSize="15sp" />
		<Button android:id="@+id/bretzelnMinus" android:layout_width="40dp" android:layout_height="40dp"
			android:text="−" android:textSize="18sp" android:padding="0dp" />
		<TextView android:id="@+id/bretzelnCount" android:layout_width="36dp" android:layout_height="wrap_content"
			android:text="1" android:gravity="center" android:textSize="16sp" android:textStyle="bold" />
		<Button android:id="@+id/bretzelnPlus" android:layout_width="40dp" android:layout_height="40dp"
			android:text="+" android:textSize="18sp" android:padding="0dp" />
	</LinearLayout>

	<!-- Sonderwünsche -->
	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Sonderwünsche:"
		android:textStyle="bold"
		android:paddingBottom="4dp" />

	<EditText
		android:id="@+id/sonderwunschInput"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:hint="z. B. extra scharf, ohne Dressing …"
		android:inputType="textMultiLine"
		android:minLines="2"
		android:maxLines="4" />

</LinearLayout>
