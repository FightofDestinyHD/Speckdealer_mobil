<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/app_background"
	android:orientation="horizontal"
	android:padding="16dp">

	<LinearLayout
		android:layout_width="160dp"
		android:layout_height="match_parent"
		android:background="#CCFFFFFF"
		android:orientation="vertical"
		android:padding="8dp">

		<Button
			android:id="@+id/categoryWeinButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Wein" />

		<Button
			android:id="@+id/categorySoftButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:text="Softgetränke" />

		<Button
			android:id="@+id/categorySpeckButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:text="Speck" />

		<Button
			android:id="@+id/categoryKaeseButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:text="Käse" />

		<Button
			android:id="@+id/categorySnacksButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:text="Snacks" />

		<Button
			android:id="@+id/categoryPfandButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:text="Pfand" />
	</LinearLayout>

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="match_parent"
		android:layout_marginStart="12dp"
		android:layout_weight="1"
		android:background="#E6FFFFFF"
		android:orientation="vertical"
		android:padding="12dp">

		<androidx.core.widget.NestedScrollView
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:fillViewport="true">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">

				<TextView
					android:id="@+id/selectedCategoryTitle"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:textStyle="bold" />

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/articleRecyclerView"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:nestedScrollingEnabled="false" />

				<EditText
					android:id="@+id/articleNameInput"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:hint="Artikelname" />

				<EditText
					android:id="@+id/articlePriceInput"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:hint="Preis (z. B. 3.50)"
					android:inputType="numberDecimal" />

				<CheckBox
					android:id="@+id/isWeinCheckbox"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="Weinartikel (Flasche/Glas)" />

				<LinearLayout
					android:id="@+id/wineOptionsContainer"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical">

					<CheckBox
						android:id="@+id/hasBottleCheckbox"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:checked="true"
						android:text="Flasche" />

					<CheckBox
							android:id="@+id/hasGlass01Checkbox"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="Glas 0,1l" />

						<EditText
							android:id="@+id/glass01PriceInput"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginStart="16dp"
							android:hint="Preis Glas 0,1l (z. B. 2.50)"
							android:inputType="numberDecimal" />

						<CheckBox
							android:id="@+id/hasGlass02Checkbox"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="Glas 0,2l" />

						<EditText
							android:id="@+id/glass02PriceInput"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginStart="16dp"
							android:hint="Preis Glas 0,2l (z. B. 3.50)"
							android:inputType="numberDecimal" />

					<CheckBox
						android:id="@+id/glassDepositOptionalCheckbox"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Pfand bei Glas wählbar" />
				</LinearLayout>

				<CheckBox
					android:id="@+id/depositApplicableCheckbox"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:checked="true"
					android:text="Pfand automatisch anwenden" />

				<Button
					android:id="@+id/selectImageButton"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="Bild auswählen" />

				<TextView
					android:id="@+id/selectedImageLabel"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="Kein Bild gewählt" />

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:orientation="horizontal">

					<Button
						android:id="@+id/saveArticleButton"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="Speichern" />

					<Button
						android:id="@+id/clearArticleButton"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginStart="8dp"
						android:layout_weight="1"
						android:text="Leeren" />
				</LinearLayout>

			</LinearLayout>
		</androidx.core.widget.NestedScrollView>

	</LinearLayout>

</LinearLayout>
